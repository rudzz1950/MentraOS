{
  "contract": "ecosystem-events",
  "version": 1,
  "notes": "Ring <-> phone <-> glasses events on the canonical envelope (miniapps/assistant/src/bus/envelope.ts). The phone is the routing hub: there is no direct ring-to-glasses link. Unknown payload fields are ignored, as in LINK_CONTRACT.md. Generated code: scripts/gen-ecosystem-c.py.",
  "classes": {
    "intent": "A user-intent command. Interactive priority, strictly ordered, short TTL, must be ACKed or NACKed.",
    "response": "A device's ACK or NACK of a command, by command id.",
    "telemetry": "State and measurements. Telemetry priority, may arrive out of order, never ACKed."
  },
  "nack_reasons": ["unsupported", "busy", "invalid", "expired", "not_permitted", "device_error"],
  "events": [
    {"type": "intent.assistant_activate", "class": "intent", "ttl_ms": 1500, "fields": {}},
    {"type": "intent.scroll", "class": "intent", "ttl_ms": 800, "fields": {"direction": {"enum": ["up", "down"]}}},
    {"type": "intent.select", "class": "intent", "ttl_ms": 800, "fields": {}},
    {"type": "intent.back", "class": "intent", "ttl_ms": 800, "fields": {}},
    {"type": "intent.dismiss", "class": "intent", "ttl_ms": 800, "fields": {}},
    {"type": "intent.mute", "class": "intent", "ttl_ms": 1500, "fields": {"on": {"type": "bool"}}},
    {"type": "intent.capture_request", "class": "intent", "ttl_ms": 2000, "fields": {"purpose": {"enum": ["vision_qa", "upi_scan"]}}},
    {"type": "response.ack", "class": "response", "ttl_ms": 5000, "fields": {"command_id": {"type": "id"}}},
    {"type": "response.nack", "class": "response", "ttl_ms": 5000, "fields": {"command_id": {"type": "id"}, "reason": {"enum_ref": "nack_reasons"}}},
    {"type": "telemetry.battery", "class": "telemetry", "ttl_ms": 60000, "fields": {"percent": {"type": "uint", "max": 100}, "charging": {"type": "bool"}}},
    {"type": "telemetry.link", "class": "telemetry", "ttl_ms": 10000, "fields": {"rssi_dbm": {"type": "int", "min": -127, "max": 20}}}
  ]
}
